# Server Configuration
PORT=5000

# MongoDB Connection String
# For Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/restaurant_db

# For MongoDB Atlas (replace <username>, <password>, and <cluster-url>):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/restaurant_db?retryWrites=true&w=majority

# Reservation Settings
# Maximum number of confirmed table reservations allowed in the same time slot
MAX_RESERVATIONS_PER_SLOT=5
